# Copy to .env — never commit .env (gitignored).
# Compose builds DATABASE_URL for the API from POSTGRES_* (see docker-compose.yml).

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=tama
POSTGRES_PORT=5432

PORT=3000
LOG_LEVEL=info
MAIN_API_URL=http://localhost:3000
FAKESTORE_BASE_URL=https://fakestoreapi.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
